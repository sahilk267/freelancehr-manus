# Do not commit a populated environment file. Configure real values in Hostinger hPanel.
NODE_ENV=production
# Leave PORT host-managed when Hostinger provides it.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
OPENROUTER_API_KEY=
APP_BASE_URL=https://freelancehr.overseasjob.in
# Initial private testing: only PRIMARY_OWNER_EMAIL/PRIMARY_OWNER_OPEN_ID may use protected routes.
OWNER_ONLY_MODE=true
VITE_AUTH_MODE=oidc
AUTH_MODE=oidc
# Use a cryptographically random value with at least 32 characters.
SESSION_SECRET=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://freelancehr.overseasjob.in/api/auth/oidc/callback
# Set one primary owner identifier before first OIDC login; no self-service owner promotion exists.
PRIMARY_OWNER_OPEN_ID=
# Or use the normalized primary owner email if your OIDC provider does not expose a stable subject ahead of time.
PRIMARY_OWNER_EMAIL=
# Production uses private S3-compatible storage. Do not configure public bucket/object access.
PRIVATE_STORAGE_MODE=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
# Hostinger Mail API remains disabled until all values below are supplied and verified.
# For the first private test, keep outbound delivery in safe/approval-controlled mode.
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAIL_FROM_DOMAIN=overseasjob.in
HOSTINGER_MAILBOX_OWNER_ID=
HOSTINGER_MAILBOX_CLIENTS_ID=
HOSTINGER_MAILBOX_TALENT_ID=
HOSTINGER_MAILBOX_INTERVIEWS_ID=
HOSTINGER_MAILBOX_FINANCE_ID=
HOSTINGER_MAILBOX_PRIVACY_ID=
HOSTINGER_MAIL_WEBHOOK_SECRET=
